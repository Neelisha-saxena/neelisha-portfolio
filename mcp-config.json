{
  "mcpServers": {
    "outlook": {
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "OUTLOOK_CLIENT_ID": "${OUTLOOK_CLIENT_ID}",
        "OUTLOOK_CLIENT_SECRET": "${OUTLOOK_CLIENT_SECRET}",
        "OUTLOOK_TENANT_ID": "${OUTLOOK_TENANT_ID:-common}",
        "OUTLOOK_REDIRECT_URI": "${OUTLOOK_REDIRECT_URI:-http://localhost:3000/auth/callback}"
      }
    }
  }
}